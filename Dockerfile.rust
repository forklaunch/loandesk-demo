# Generated by ForkLaunch (sha256:897b40da34b246db4edc81e3f18e7704d43468f17c945bbf5d2ad0539260691f); the CLI regenerates this file until it is edited.
# Generated shared Rust image. Run cargo generate-lockfile before the first image build.
FROM rust:1.98.0-alpine AS builder
WORKDIR /app
RUN apk add --no-cache musl-dev ca-certificates cmake make g++ perl pkgconf
COPY [".cargo/config.toml","/app/.cargo/config.toml"]
COPY [".forklaunch/manifest.toml","/app/.forklaunch/manifest.toml"]
COPY ["Cargo.lock","/app/Cargo.lock"]
COPY ["Cargo.toml","/app/Cargo.toml"]
COPY ["src/api/","/app/src/api/"]
COPY ["src/client-sdk/","/app/src/client-sdk/"]
COPY ["src/extraction/","/app/src/extraction/"]
COPY ["src/shared/","/app/src/shared/"]
ENV SQLX_OFFLINE=true
# The commit this image was built from; reported in startup logs and /health.
ARG GIT_SHA=""
ENV GIT_SHA=${GIT_SHA}
ARG CARGO_BUILD_JOBS=2
# Registry downloads retry instead of failing the build on a slow connection.
ENV CARGO_NET_RETRY=10 CARGO_HTTP_MULTIPLEXING=false CARGO_HTTP_TIMEOUT=120
# The registry and target directories are build caches, so a source change
# recompiles only what it touched. Binaries are copied out of the cache mount.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo build --locked --release --workspace --bins \
    && mkdir -p /app/out && cp target/release/api target/release/extraction /app/out/
FROM alpine:3.24 AS runtime
WORKDIR /app
RUN apk upgrade --no-cache && apk add --no-cache ca-certificates curl
ADD --chmod=0644 https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem /app/certs/rds-global-bundle.pem
RUN chmod 0755 /app/certs
COPY --from=builder /app/out/api /app/bin/api
COPY --from=builder /app/out/extraction /app/bin/extraction
# RUST_LOG is required at startup and the platform does not set it; a stored
# value or the Compose file overrides this default.
ENV HOST=0.0.0.0 PROTOCOL=http PORT=8000 VERSION=v1 DOCS_PATH=/docs RUST_LOG=info
USER 65532:65532
