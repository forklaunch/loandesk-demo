# Every setting LoanDesk reads. `docker compose up --build` needs none of them:
# the local stack generates its own secrets (scripts/demo-secrets.sh).
# Copy to .env to override Compose defaults. Never commit a real .env.
# In a deployment these come from the platform's secret manager (docs/deployment.md).

# --- Local Compose stack ----------------------------------------------------
WEB_PORT=41080                 # Host port of the web UI (bound to 127.0.0.1)
CARGO_BUILD_JOBS=4             # Parallel rustc jobs for the image build
GIT_SHA=                       # Commit recorded in the image, startup log and /health
LOANDESK_VERSION=local         # Image tag

# --- Mode ---------------------------------------------------------------------
APP_ENV=development            # `production` refuses demo secrets, demo seeding, insecure cookies, plaintext DB, http origin
RUST_LOG=info                  # Log level (per environment)
SEED_DEMO_DATA=true            # LOCAL DEMO ONLY: fictional users and applications on an empty database
DEMO_PASSWORD=loandesk-demo-2026   # LOCAL DEMO ONLY: password of the seeded demo users
COOKIE_SECURE=false            # Must be true (HTTPS) in production
SESSION_HOURS=8
MFA_REQUIRED_FOR_ADMINS=       # Defaults to true in production, false otherwise

# --- Service (API) ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
PROTOCOL=http
VERSION=v1
DOCS_PATH=/docs                # OpenAPI UI; not served in production
PUBLIC_ORIGIN=                 # The exact origin browsers use, e.g. https://loandesk.example.com
CORS_ORIGINS=                  # Extra exact origins, comma-separated; `*` is rejected

# --- Database -----------------------------------------------------------------
DATABASE_URL=                  # Restricted runtime role; remote hosts need sslmode=verify-full
MIGRATION_DATABASE_URL=        # Schema-owner role, used only by `--migrate`
DATABASE_ALLOW_PLAINTEXT_DEVELOPMENT=false   # true only on a private local network; refused in production
DATABASE_MAX_CONNECTIONS=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
TENANT_ID=                     # Trusted non-nil UUID for this deployment
LEGACY_DATA_ENCRYPTION_KEY=    # Only when adopting a pre-ForkLaunch database: its DATA_ENCRYPTION_KEY

# --- Rate limits (requests per minute; cannot be 0) ---------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=60       # Sign-in attempts per client address
RATE_LIMIT_REQUESTS_PER_MINUTE=600   # Signed-in requests per user
RATE_LIMIT_EXPENSIVE_PER_MINUTE=60   # Search, export, SSN reveal, document grants, password hashing per user

# --- Retention and access housekeeping (worker's scheduled job) ---------------
# DEMO DEFAULTS. Each period must be confirmed by its owner before real records
# are held (docs/data-classification.md, "Retention").
RETENTION_DECIDED_APPLICATION_DAYS=2555    # Delete decided applications 7 years after the decision; 0 keeps them
RETENTION_UNDECIDED_APPLICATION_DAYS=1095  # Delete never-decided applications 3 years after creation; 0 keeps them
RETENTION_UNFINISHED_UPLOAD_HOURS=24       # Remove upload grants that were never confirmed
LIFECYCLE_INTERVAL_SECONDS=3600            # Time between passes; 0 turns the schedule off
LIFECYCLE_BATCH_SIZE=50                    # Applications deleted per transaction
ACCESS_STALE_DAYS=90                       # An account unused this long is stale
ACCESS_STALE_ACTION=disable                # disable (and end sessions) or flag (report only)
ACCESS_REVIEW_INTERVAL_DAYS=90             # Warn when no access review was recorded this long
ENCRYPTION_KEY_MAX_AGE_DAYS=365            # Warn when the active key is older (docs/runbooks/key-rotation.md)

# --- Field encryption (rotation: docs/runbooks/key-rotation.md) ---------------
STORAGE_ENCRYPTION_NAMESPACE=loandesk-records   # Keep stable; changing it orphans ciphertext
ENCRYPTION_KEY_ID=             # Name of the active key
ENCRYPTION_KEY_HEX=            # 32 random bytes as 64 hex digits: `openssl rand -hex 32`
ENCRYPTION_PREVIOUS_KEYS_JSON= # {"old-id":"<hex>"} so rows written under earlier keys stay readable
ENCRYPTION_LEGACY_KEY_HEX=disabled

# --- Object storage -----------------------------------------------------------
S3_BUCKET=
S3_REGION=                     # Where documents are stored
S3_URL=                        # Only for S3-compatible stores; omit for AWS S3
S3_ACCESS_KEY_ID=              # Omit both to use the task role
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=                 # Browser-facing base for signed links when S3_URL is internal

# --- Worker -------------------------------------------------------------------
WORKER_QUEUE=extraction
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_SECONDS=5
WORKER_CONCURRENCY=2
WORKER_BATCH_SIZE=1
WORKER_POLL_MS=500
WORKER_LEASE_MS=60000
WORKER_RENEW_MS=20000
WORKER_DRAIN_MS=30000
WORKER_ALLOW_PLAINTEXT_DEVELOPMENT=false
WORKER_COMPLETED_RETENTION_SECONDS=604800    # Finished jobs purged after 7 days
WORKER_FAILED_RETENTION_SECONDS=2592000      # Dead letters purged after 30 days
WORKER_RETENTION_INTERVAL_MS=60000
WORKER_RETENTION_BATCH_LIMIT=100
WORKER_RETENTION_TIMEOUT_MS=5000
WORKER_HTTP_ADDR=              # e.g. 0.0.0.0:8081 for /health and /ready
WORKER_CONTROL_TOKEN=          # 32+ characters; enables pause/resume/drain

# --- Telemetry ----------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=   # e.g. http://otel-collector:4318; unset = JSON logs to stdout only
OTEL_RESOURCE_ATTRIBUTES=
