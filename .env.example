# Optional. `docker compose up --build` works without a .env file, using
# local-demo defaults. Copy to .env and edit to override.

# Host port for the web UI (bound to 127.0.0.1 only).
WEB_PORT=41080

# Database password. Only applied when the database volume is first created.
POSTGRES_PASSWORD=change-me

# Key that encrypts owner SSNs: `openssl rand -base64 32`.
# Losing this key makes stored SSNs unreadable; changing it does the same.
DATA_ENCRYPTION_KEY=

# Demo users and applications, created once on an empty database.
SEED_DEMO_DATA=true
DEMO_PASSWORD=loandesk-demo-2026

# For a real deployment: APP_ENV=production refuses the development key and
# demo seeding, and requires COOKIE_SECURE=true (i.e. HTTPS in front).
APP_ENV=development
COOKIE_SECURE=false
