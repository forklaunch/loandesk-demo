# Shared settings of the backend containers in docker-compose.yaml (LOCAL STACK ONLY).
# No secrets: those are generated on first start (scripts/demo-secrets.sh).
# A deployment sets its own values (docs/hosting.md, docs/deployment.md).
APP_ENV=${APP_ENV:-development}
RUST_LOG=${RUST_LOG:-info}
# One trusted tenant per deployment; not a secret.
TENANT_ID=${TENANT_ID:-6f1d5a0e-58f4-4c58-9a51-0c2f6b1d7c11}
# Plaintext database connections are allowed only on this private Compose
# network. Refused when APP_ENV=production.
DATABASE_ALLOW_PLAINTEXT_DEVELOPMENT=true
WORKER_ALLOW_PLAINTEXT_DEVELOPMENT=true
STORAGE_ENCRYPTION_NAMESPACE=loandesk-records
ENCRYPTION_KEY_ID=${ENCRYPTION_KEY_ID:-demo-1}
ENCRYPTION_PREVIOUS_KEYS_JSON=${ENCRYPTION_PREVIOUS_KEYS_JSON:-}
ENCRYPTION_LEGACY_KEY_HEX=disabled
S3_URL=http://object-store:9000
S3_BUCKET=loandesk-documents
S3_REGION=us-east-1
WORKER_QUEUE=extraction
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_SECONDS=5
# Access housekeeping. DEMO DEFAULTS, to be confirmed by the access-control
# owner (docs/data-classification.md): an account unused for 90 days is
# stale and is disabled by the worker's scheduled job; an access review is
# due every 90 days.
ACCESS_STALE_DAYS=${ACCESS_STALE_DAYS:-90}
ACCESS_REVIEW_INTERVAL_DAYS=${ACCESS_REVIEW_INTERVAL_DAYS:-90}
# Set to http://otel-collector:4318 together with `--profile observability`.
OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT:-}
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=${APP_ENV:-development}
# Browsers reach the object store through the web container, same origin.
S3_PUBLIC_URL=/storage
COOKIE_SECURE=${COOKIE_SECURE:-false}
